<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);CS8765;CS8767</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Source\Form\MidSection\**" />
	  <Compile Remove="Source\Form\SurfaceVelocity\**" />
	  <EmbeddedResource Remove="Source\Form\MidSection\**" />
	  <EmbeddedResource Remove="Source\Form\SurfaceVelocity\**" />
	  <None Remove="Source\Form\MidSection\**" />
	  <None Remove="Source\Form\SurfaceVelocity\**" />
	</ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\AFMSDll\AFMSDll.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RnsLibrary">
      <HintPath>..\Dll\RnsLibrary.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>